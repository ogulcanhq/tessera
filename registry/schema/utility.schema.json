{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
    },
    "kind": {
      "type": "string",
      "const": "utility"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "source": {
      "type": "object",
      "properties": {
        "files": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^Sources\\/.+\\.swift$"
          }
        }
      },
      "required": [
        "files"
      ],
      "additionalProperties": false
    },
    "dependencies": {
      "default": {
        "utilities": []
      },
      "type": "object",
      "properties": {
        "utilities": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "kind",
    "summary",
    "source"
  ],
  "additionalProperties": false
}
